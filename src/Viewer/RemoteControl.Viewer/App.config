<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- SHA-256 отпечаток корневого сертификата внутреннего ЦС (AD CS). Пусто = любой доверенный корень. -->
    <add key="InternalRootCaThumbprint" value="" />
    <!-- Порт агента (по умолчанию 5900). -->
    <add key="AgentPort" value="5900" />
    <!-- Путь к собранному агенту для push-развёртывания. -->
    <add key="AgentExePath" value="C:\Program Files\RemoteControl\RemoteControlAgent.exe" />
    <!-- Устанавливать агент автоматически при подключении. -->
    <add key="PushAgentByDefault" value="true" />
  </appSettings>
</configuration>
